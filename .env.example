# ============================================================================
# baidu-service 环境模板
#   cp .env.example .env
#
# 每个旋钮都必须有人读（本仓由 tests/test_wiring.py 的配置门禁守着）——
# 不登记"暂时用不到"的旋钮，免得它们变成假配置。
# ============================================================================

# ---------------------------------------------------------------- 上游（chat.baidu.com）
# 图片编辑的唯一端点：POST {BASE_URL}/aichat/api/conversation（SSE 同步，无任务 id）。
BAIDU_BASE_URL=https://chat.baidu.com

# BOS 桶与 CDN：输入图转存用。**只在联调/冒烟时应改**，生产保持默认。
# BOS_HOST 也可带 scheme（如 http://127.0.0.1:8800/bos）——仅用于指向本地假上游。
BAIDU_BOS_HOST=aisearch.bj.bcebos.com
BAIDU_CDN_BASE=https://aisearch.cdn.bcebos.com

# 🔴 cookie —— **唯一必需的上游凭据**（文心免登录也需要；去掉 cookie 立刻「服务繁忙」无图）。
# 铸造方式（免登录、零生成请求；对 metaso/qwen 的「匿名身份」模式）：
#   python wenxin/tools/mint_identity.py   # 产物 identity.json 的 `cookie` 字段填这里
# ⚠️ 它是凭据：不要提交 .env、不要贴进 issue、不要在日志里回显。
BAIDU_COOKIE=

# token/lid **可选**：留空则运行时从首页现取并缓存（TTL 540s）。
# 手工填的值实测只活 ≥10 分钟 —— 本就不该当配置项；显式配了就不自动现取（排障 / 钉值用）。
# 🔴 LID 必须是**页面级 searchframeLid**，用会话 ori_lid 会稳定吃 tokenFail。
BAIDU_SESSION_TOKEN=
BAIDU_LID=
# 会话 ID（body.searchInfo.ori_lid）；留空则复用 LID。
BAIDU_ORI_LID=

# 输入图送上游的方式：
#   bos    恒转存 BOS（默认；多花 1~2s 换稳定 —— 上游抓外链会失败）
#   direct 外链直传（非 URL 输入自动降级为转存）
#   auto   同 direct（保留档位名以对齐 biz-api）
BAIDU_UPLOAD_MODE=bos

# query 文本策略：ignore=用能力中文名（唯一实证可用）；prepend=把 prompt 拼在能力名前（未验证）。
BAIDU_PROMPT_MODE=ignore

# 结果 URL 尾部的 ?x-bce-process=…（AI 水印处理参数）。
# 默认 1 = 剥离（下载即为无水印原图）；要原样（带水印）设 0。
BAIDU_STRIP_WATERMARK=1

# 转存前的图像标准化：限最长边、压到容量内、统一标准 MIME（消除上游抓取的两类失败诱因）。
BAIDU_NORMALIZE=1
BAIDU_MAX_SIDE=2048
BAIDU_MAX_BYTES=2097152

# 代取外链输入 / 取回结果图的硬字节上限（MB）。
BAIDU_MAX_DOWNLOAD_MB=30

# 结果图取回超时（秒）。比输入取回的 30s 宽：上游结果图在境外 CDN，
# 2026-09-24 实测有 38~47s 的偶发慢（表现为 504）。
BAIDU_RESULT_FETCH_TIMEOUT=60

# 结果图取回重试次数（只重试瞬时错误：超时/网络错误/5xx/429；4xx 与超限不重试）。
BAIDU_RESULT_FETCH_RETRIES=2

# 老接口（image.baidu.com/aigc）入参上限：长边像素 / 字节。**超限自动等比压缩后再提交**。
# 依据（2026-09-24 实测 type=1 去水印）：600x400/39.9KB 收单；800x533/63.2KB、900x600/73.3KB 被拒。
BAIDU_LEGACY_MAX_IMAGE_SIDE=640
BAIDU_LEGACY_MAX_IMAGE_BYTES=40000

# 上游 SSE 总超时（变清晰实测 5.5s、提线稿 20~25s；另加转存与结果下载）。
BAIDU_TIMEOUT=180

# ---------------------------------------------------------------- 上行节奏（进程内闸门）
# 昆仑风控是**风险评分**而非计数器（docs/UPSTREAM.md §7）：串行 + 最小间隔 + 每分钟上限，
# 命中即进冷却窗。三个旋钮就是研究结论里的推荐值。
BAIDU_MIN_INTERVAL=4
BAIDU_PER_MINUTE=8
# 排队可等的上限（秒）；超过直接 429（带 Retry-After）。
BAIDU_MAX_WAIT=20
# 命中昆仑后的静默窗（秒）——窗内零上游请求。
BAIDU_COOLDOWN=600

# 出口代理池（逗号分隔的 http(s)/socks5h 代理 URL）。空 = 直连。
# 配置后**每个上游请求换一个新出口**（新建连接）。
# 📌 文心的门禁是**出口维度**的风险评分 —— 换到未滥用出口即恢复；这是唯一被证明有效
# 的换线手段（身份/cookie 维度已证否；伪造 XFF 未被证明有效）。
# ⚠️ 用它跑量会把整池出口一起覆盖，由部署方决定。
BAIDU_PROXY_POOL=

# ---------------------------------------------------------------- 老接口兜底（image.baidu.com/aigc）
# 老接口（百度AI图片助手）与新接口是**两条独立的生成链路**（不同 host / 不同产品）：
# 主链被昆仑风控时，老接口是另一条可用通路 —— 这就是"兜底"的依据。
#   off      不启用（默认；行为与纯主链完全一致）
#   fallback 主链命中**风控 / 上游未产出**时，有老接口映射的能力自动改走老接口；
#            **冷却窗内也直接走老接口**（不 429，这才是兜底的意义）
#   prefer   直接走老接口（演练 / 主链故障期）
# 实测（2026-09-24）：老接口匿名可用；type=3（变清晰）/ type=1（去水印）均秒级出图。
# 目前有老接口映射的能力（2026-09-24 全量矩阵实测）：
#   clarity(3) / expand(4) / matting(9) / sketch(15) / dewatermark(1) /
#   erase(8，需 mask) / replace(5，需 mask+prompt) / redraw(6，AI重绘，legacy-only) /
#   similar(7，相似图，legacy-only)
# 开启后这些在 /v1/models 与 /capabilities 里按"可用"呈现；无映射的能力**不因开关变可用**。
BAIDU_LEGACY=off
BAIDU_LEGACY_BASE=https://image.baidu.com
# 轮询节奏：首查通常 2s 内就绪；上限 ≈ interval × tries ≈ 60s
BAIDU_LEGACY_POLL_INTERVAL=1.5
BAIDU_LEGACY_POLL_TRIES=40

# ---------------------------------------------------------------- 本服务
# 逗号分隔静态 Key 白名单。留空 = 关闭鉴权（仅限内网/联调，启动会 WARNING）。
BAIDU_API_KEYS=
BAIDU_PORT=8700
BAIDU_LOG_LEVEL=INFO
# response_format=url 时的落盘目录（文件不设 TTL，由部署方清理）。
BAIDU_MEDIA_DIR=var/media

# 未取证能力闸门：dewatermark / replace / erase / reimagine 默认不可用（见 app/models.py）。
BAIDU_ALLOW_UNVERIFIED=0

# ---------------------------------------------------------------- 可观测性（可选，可静默降级）
BAIDU_LOGFIRE_TOKEN=
BAIDU_OTEL_SERVICE_NAME=baidu-service
BAIDU_LOGFIRE_ENVIRONMENT=
BAIDU_OTEL_CAPTURE_UPSTREAM=1
BAIDU_OTEL_SCRUBBING=0
